# YYC³ Cloud Intelli-Matrix — EditorConfig
# 跨编辑器统一基础规范 (TRAE CN / VS Code / WebStorm 通用)

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{css,scss,less}]
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.py]
indent_size = 4
