# YYC³ CloudPivot Intelli-Matrix 环境变量配置示例模板
# Environment Variables Example Template
# @file: .env.example
# @description: CloudPivot Intelli-Matrix 环境变量配置示例模板
# @author: YanYuCloudCube Team <admin@0379.email>
# @version: v1.0.0
# @created: 2026-03-22

# ==================== API 代理网关基础配置 ====================
# API Proxy Gateway Configuration
# YYC³ Gateway API 基础 URL（必需）
API_PROXY_BASE_URL=https://api.0379.world

# API 代理超时时间（毫秒）
API_PROXY_TIMEOUT=30000

# API 代理版本
API_PROXY_VERSION=1.0.0

# ==================== WebSocket Configuration ====================
# WebSocket server for real-time data push
# WebSocket 服务器地址（必需）
VITE_WS_URL=ws://localhost:3113/ws

# ==================== Application Configuration ====================
# Application name and version
# 应用名称
VITE_APP_NAME=YYC³ CloudPivot Intelli-Matrix

# 应用版本
VITE_APP_VERSION=0.0.1

# ==================== Deployment Configuration ====================
# Production deployment URL
# 应用部署 URL（必需）
VITE_APP_URL=http://192.168.3.22:3118

# ==================== Feature Flags ====================
# Enable/disable features
# 启用幽灵模式（true/false）
VITE_ENABLE_GHOST_MODE=true

# 启用 PWA（true/false）
VITE_ENABLE_PWA=true

# 启用 AI 助手（true/false）
VITE_ENABLE_AI_ASSISTANT=true

# ==================== Development Configuration ====================
# Enable development mode features
# 开发模式（true/false）
VITE_DEV_MODE=true

# 调试模式（true/false）
VITE_DEBUG_MODE=false

# ==================== API Configuration ====================
# API endpoints (if any)
# API 基础 URL（必需）
VITE_API_BASE_URL=http://localhost:3118/api

# ==================== Logging Configuration ====================
# Log level: error, warn, info, debug
# 日志级别（debug, info, warn, error）
VITE_LOG_LEVEL=info

# ==================== Performance Configuration ====================
# WebSocket reconnection settings
# WebSocket 重连间隔（毫秒）
VITE_WS_RECONNECT_INTERVAL=5000

# WebSocket 最大重连次数
VITE_WS_MAX_RECONNECT_ATTEMPTS=10

# WebSocket 心跳间隔（毫秒）
VITE_WS_HEARTBEAT_INTERVAL=30000

# ==================== UI Configuration ====================
# Theme configuration
# 默认主题
VITE_DEFAULT_THEME=cyberpunk

# 默认语言
VITE_DEFAULT_LANGUAGE=zh-CN

# ==================== Security Configuration ====================
# Enable security features
# 启用 CSP（true/false）
VITE_ENABLE_CSP=true

# 启用 XSS 保护（true/false）
VITE_ENABLE_XSS_PROTECTION=true

# ==================== 数据库配置 ====================
# PostgreSQL Database Configuration
# PostgreSQL 密码（必需）
POSTGRES_PASSWORD=your_postgres_password

# 数据库主机地址（容器内使用 postgres，本地使用 localhost）
DB_HOST=postgres

# 数据库端口（容器内 5432，本地映射 5433）
DB_PORT=5432

# 数据库用户名
DB_USER=postgres

# 数据库密码（必需）
DB_PASSWORD=your_postgres_password

# 数据库名称
DB_NAME=yyc3_gpt

# ==================== Redis配置 ====================
# Redis Cache Configuration
# Redis 主机地址（容器内使用 redis，本地使用 localhost）
REDIS_HOST=redis

# Redis 端口
REDIS_PORT=6379

# Redis 数据库编号（0-15）
REDIS_DB=0

# Redis 密码（可选）
REDIS_PASSWORD=

# ==================== API密钥配置 ====================
# API Keys Configuration
# OpenAI API 密钥（可选）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 智谱 AI API 密钥（必需）
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.K4YQgN2p4950nnE2

# ==================== Ollama配置 ====================
# Ollama Local Model Service Configuration
# Ollama 主机地址（Docker 内使用 host.docker.internal，本地使用 localhost）
OLLAMA_HOST=host.docker.internal

# Ollama 端口（重要：从 11434 变更为 11435）
OLLAMA_PORT=11435

# Ollama 模型存储路径
OLLAMA_MODELS=/mnt/models

# ==================== API服务配置 ====================
# Gateway API Service Configuration
# API 监听地址
API_HOST=0.0.0.0

# API 端口
API_PORT=8000

# API 工作进程数
API_WORKERS=4

# API 调试模式（生产环境设为 false）
API_DEBUG=false

# API 日志级别（debug, info, warn, error）
API_LOG_LEVEL=info

# ==================== 网络配置 ====================
# Network Configuration
# 主机 IP 地址
HOST_IP=10.200.0.2

# 主机 IP 后缀
HOST_IP_SUFFIX=2

# ==================== 监控配置 ====================
# Monitoring Configuration
# Prometheus 多进程目录
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# 启用 Prometheus（true/false）
PROMETHEUS_ENABLED=true

# 启用 Grafana（true/false）
GRAFANA_ENABLED=true

# 启用 Alertmanager（true/false）
ALERTMANAGER_ENABLED=true

# ==================== MCP配置 ====================
# MCP Tools Configuration
# Brave Search API 密钥（必需）
BRAVE_API_KEY=BSAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub 个人访问令牌（必需）
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== NFS挂载配置 ====================
# NFS Mount Configuration
# NFS 服务器主机地址（必需）
NFS_HOST=192.168.3.45

# NFS 共享路径（必需）
NFS_PATH=/Volume2/yyc3-33

# 本地挂载点（必需）
NFS_MOUNT_POINT=/Users/yanyu/nfs_vpn_mount

# ==================== 域名配置 ====================
# Domain Configuration
# API 域名（生产环境必需）
API_DOMAIN=api.0379.world

# Grafana 域名（生产环境必需）
GRAFANA_DOMAIN=grafana.0379.world

# Prometheus 域名（生产环境必需）
PROMETHEUS_DOMAIN=prometheus.0379.world

# ==================== 端口映射配置 ====================
# Port Mapping Configuration
# PostgreSQL 端口映射（容器端口:主机端口）
POSTGRES_PORT_MAPPING=5432:5433

# Redis 端口映射
REDIS_PORT_MAPPING=6379:6379

# Ollama 端口映射
OLLAMA_PORT_MAPPING=11435:11435

# API 端口映射
API_PORT_MAPPING=8000:8000

# Grafana 端口映射
GRAFANA_PORT_MAPPING=3000:3000

# Prometheus 端口映射
PROMETHEUS_PORT_MAPPING=9090:9090

# Traefik 端口映射
TRAEFIK_PORT_MAPPING=80:80,443:443,8080:8080

# ==================== CloudPivot Intelli-Matrix 专用配置 ====================
# CloudPivot Intelli-Matrix Specific Configuration
# CloudPivot Matrix 端口（必需）
CLOUDPIVOT_MATRIX_PORT=3118

# CloudPivot Matrix WebSocket 端口（必需）
CLOUDPIVOT_MATRIX_WS_PORT=3113

# CloudPivot Matrix 主机地址（必需）
CLOUDPIVOT_MATRIX_HOST=192.168.3.22

# ==================== 缓存配置 ====================
# Cache Configuration
# 启用缓存（true/false）
CACHE_ENABLED=true

# 缓存过期时间（秒）
CACHE_TTL=3600

# 缓存最大条目数
CACHE_MAX_SIZE=1000

# ==================== 速率限制配置 ====================
# Rate Limiting Configuration
# 启用速率限制（true/false）
RATE_LIMIT_ENABLED=true

# 速率限制请求数
RATE_LIMIT_REQUESTS=100

# 速率限制时间窗口（秒）
RATE_LIMIT_WINDOW=60

# ==================== SSL/TLS配置 ====================
# SSL/TLS Configuration
# 启用 SSL（true/false）
SSL_ENABLED=true

# SSL 证书路径（生产环境必需）
SSL_CERT_PATH=/etc/ssl/certs/api.0379.world.crt

# SSL 私钥路径（生产环境必需）
SSL_KEY_PATH=/etc/ssl/private/api.0379.world.key

# ==================== 安全配置 ====================
# Security Configuration
# 启用 CORS（true/false）
CORS_ENABLED=true

# CORS 允许的源（生产环境必需）
CORS_ORIGINS=https://0379.world,https://api.0379.world

# CORS 允许的方法
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# CORS 允许的头部
CORS_HEADERS=Content-Type,Authorization

# ==================== 备份配置 ====================
# Backup Configuration
# 启用备份（true/false）
BACKUP_ENABLED=true

# 备份计划（Cron 表达式）
BACKUP_SCHEDULE=0 2 * * *

# 备份保留天数
BACKUP_RETENTION_DAYS=30

# 备份路径（必需）
BACKUP_PATH=/Users/yanyu/nfs_vpn_mount/backup

# ==================== 健康检查配置 ====================
# Health Check Configuration
# 启用健康检查（true/false）
HEALTH_CHECK_ENABLED=true

# 健康检查间隔（秒）
HEALTH_CHECK_INTERVAL=30

# 健康检查超时（秒）
HEALTH_CHECK_TIMEOUT=10

# 健康检查重试次数
HEALTH_CHECK_RETRIES=3

# ==================== 开发工具配置 ====================
# Development Tools Configuration
# 热重载（true/false）
HOT_RELOAD=true

# 自动重启（true/false）
AUTO_RESTART=true

# 调试模式（true/false）
DEBUG_MODE=false

# 详细日志（true/false）
VERBOSE_LOGGING=false

# 性能分析（true/false）
PROFILING_ENABLED=false