# YYC³ CloudPivot Intelli-Matrix 生产环境配置文件
# Production Environment Configuration
# @file: .env.production
# @description: CloudPivot Intelli-Matrix 生产环境配置
# @author: YanYuCloudCube Team <admin@0379.email>
# @version: v1.0.0
# @created: 2026-03-22

# ==================== API 代理网关基础配置 ====================
# API Proxy Gateway Configuration
API_PROXY_BASE_URL=https://api.0379.world
API_PROXY_TIMEOUT=30000
API_PROXY_VERSION=1.0.0

# ==================== WebSocket Configuration ====================
# WebSocket server for real-time data push
VITE_WS_URL=wss://api.0379.world/ws

# ==================== Application Configuration ====================
# Application name and version
VITE_APP_NAME=YYC³ CloudPivot Intelli-Matrix
VITE_APP_VERSION=0.0.1

# ==================== Deployment Configuration ====================
# Production deployment URL
VITE_APP_URL=https://api.0379.world

# ==================== Feature Flags ====================
# Enable/disable features
VITE_ENABLE_GHOST_MODE=false
VITE_ENABLE_PWA=true
VITE_ENABLE_AI_ASSISTANT=true

# ==================== Development Configuration ====================
# Enable development mode features
VITE_DEV_MODE=false
VITE_DEBUG_MODE=false

# ==================== API Configuration ====================
# API endpoints (if any)
VITE_API_BASE_URL=https://api.0379.world/api

# ==================== Logging Configuration ====================
# Log level: error, warn, info, debug
VITE_LOG_LEVEL=info

# ==================== Performance Configuration ====================
# WebSocket reconnection settings
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10
VITE_WS_HEARTBEAT_INTERVAL=30000

# ==================== UI Configuration ====================
# Theme configuration
VITE_DEFAULT_THEME=cyberpunk
VITE_DEFAULT_LANGUAGE=zh-CN

# ==================== Security Configuration ====================
# Enable security features
VITE_ENABLE_CSP=true
VITE_ENABLE_XSS_PROTECTION=true

# ==================== 数据库配置 ====================
# PostgreSQL Database Configuration
POSTGRES_PASSWORD=your_production_password
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_production_password
DB_NAME=yyc3_gpt

# ==================== Redis配置 ====================
# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password

# ==================== API密钥配置 ====================
# API Keys Configuration
OPENAI_API_KEY=your_openai_api_key
ZHIPU_API_KEY=your_zhipu_api_key

# ==================== Ollama配置 ====================
# Ollama Local Model Service Configuration
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11435
OLLAMA_MODELS=/mnt/models

# ==================== API服务配置 ====================
# Gateway API Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_DEBUG=false
API_LOG_LEVEL=info

# ==================== 网络配置 ====================
# Network Configuration
HOST_IP=10.200.0.2
HOST_IP_SUFFIX=2

# ==================== 监控配置 ====================
# Monitoring Configuration
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
ALERTMANAGER_ENABLED=true

# ==================== MCP配置 ====================
# MCP Tools Configuration
BRAVE_API_KEY=your_brave_api_key
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token

# ==================== NFS挂载配置 ====================
# NFS Mount Configuration
NFS_HOST=192.168.3.45
NFS_PATH=/Volume2/yyc3-33
NFS_MOUNT_POINT=/Users/yanyu/nfs_vpn_mount

# ==================== 域名配置 ====================
# Domain Configuration
API_DOMAIN=api.0379.world
GRAFANA_DOMAIN=grafana.0379.world
PROMETHEUS_DOMAIN=prometheus.0379.world

# ==================== 端口映射配置 ====================
# Port Mapping Configuration
POSTGRES_PORT_MAPPING=5432:5433
REDIS_PORT_MAPPING=6379:6379
OLLAMA_PORT_MAPPING=11435:11435
API_PORT_MAPPING=8000:8000
GRAFANA_PORT_MAPPING=3000:3000
PROMETHEUS_PORT_MAPPING=9090:9090
TRAEFIK_PORT_MAPPING=80:80,443:443,8080:8080

# ==================== CloudPivot Intelli-Matrix 专用配置 ====================
# CloudPivot Intelli-Matrix Specific Configuration
CLOUDPIVOT_MATRIX_PORT=3118
CLOUDPIVOT_MATRIX_WS_PORT=3113
CLOUDPIVOT_MATRIX_HOST=api.0379.world

# ==================== 缓存配置 ====================
# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=7200
CACHE_MAX_SIZE=5000

# ==================== 速率限制配置 ====================
# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ==================== SSL/TLS配置 ====================
# SSL/TLS Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/api.0379.world.crt
SSL_KEY_PATH=/etc/ssl/private/api.0379.world.key

# ==================== 安全配置 ====================
# Security Configuration
CORS_ENABLED=true
CORS_ORIGINS=https://0379.world,https://api.0379.world
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# ==================== 备份配置 ====================
# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/Users/yanyu/nfs_vpn_mount/backup

# ==================== 健康检查配置 ====================
# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3