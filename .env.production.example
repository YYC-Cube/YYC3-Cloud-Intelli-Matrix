# 生产环境配置示例
# 复制此文件为 .env.production 并填写实际值

# ===========================================
# 应用基础配置
# ===========================================

# 应用名称
VITE_APP_NAME=YYC3-Cloud-Intelli-Matrix

# 应用版本
VITE_APP_VERSION=1.0.0

# 环境
VITE_ENV=production

# ===========================================
# 数据库配置（可选）
# ===========================================

# 数据库类型：postgresql | mysql | mongodb
VITE_DB_TYPE=postgresql

# 数据库主机
VITE_DB_HOST=localhost

# 数据库端口
VITE_DB_PORT=5432

# 数据库名称
VITE_DB_NAME=yyc3_cloudpivot

# 数据库用户名
VITE_DB_USER=yyc3_admin

# 数据库密码（请使用强密码）
VITE_DB_PASSWORD=your_secure_password_here

# 是否启用 SSL
VITE_DB_SSL=true

# 连接超时（毫秒）
VITE_DB_CONNECTION_TIMEOUT=10000

# 最大重试次数
VITE_DB_MAX_RETRIES=3

# ===========================================
# Supabase 配置（可选）
# ===========================================

# Supabase 项目 URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase 匿名密钥
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ===========================================
# WebSocket 配置（可选）
# ===========================================

# WebSocket 服务器 URL
VITE_WS_URL=wss://your-websocket-server.com

# WebSocket 重连间隔（毫秒）
VITE_WS_RECONNECT_INTERVAL=5000

# WebSocket 最大重连次数
VITE_WS_MAX_RECONNECT_ATTEMPTS=10

# ===========================================
# AI 服务配置（可选）
# ===========================================

# AI 服务 API 密钥
VITE_AI_API_KEY=your_ai_api_key_here

# AI 服务基础 URL
VITE_AI_BASE_URL=https://api.openai.com/v1

# AI 模型
VITE_AI_MODEL=gpt-4

# ===========================================
# 监控与日志配置
# ===========================================

# 是否启用性能监控
VITE_ENABLE_PERFORMANCE_MONITORING=true

# 是否启用错误追踪
VITE_ENABLE_ERROR_TRACKING=true

# Sentry DSN（可选）
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===========================================
# 存储配置
# ===========================================

# 存储类型：localStorage | database
VITE_STORAGE_TYPE=localStorage

# 同步间隔（秒）
VITE_SYNC_INTERVAL=30

# 是否启用自动同步
VITE_AUTO_SYNC=true

# 是否启用离线模式
VITE_OFFLINE_MODE=true

# 冲突解决策略：local | remote | merge
VITE_CONFLICT_RESOLUTION=merge

# ===========================================
# 性能优化配置
# ===========================================

# 是否启用查询缓存
VITE_ENABLE_QUERY_CACHE=true

# 查询缓存过期时间（毫秒）
VITE_QUERY_CACHE_TTL=60000

# 批量查询批次大小
VITE_BATCH_QUERY_SIZE=100

# 查询超时时间（毫秒）
VITE_QUERY_TIMEOUT=5000

# 是否启用 IPC 缓存
VITE_ENABLE_IPC_CACHE=true

# IPC 缓存过期时间（毫秒）
VITE_IPC_CACHE_TTL=30000

# 最大并发 IPC 调用数
VITE_MAX_CONCURRENT_IPC=10

# ===========================================
# 安全配置
# ===========================================

# JWT 密钥（用于会话管理）
VITE_JWT_SECRET=your_jwt_secret_here

# 会话过期时间（秒）
VITE_SESSION_EXPIRY=86400

# 是否启用 CORS
VITE_ENABLE_CORS=true

# 允许的 CORS 来源
VITE_CORS_ORIGINS=https://your-domain.com

# ===========================================
# 功能开关
# ===========================================

# 是否启用 Ghost Mode（仅开发环境）
VITE_ENABLE_GHOST_MODE=false

# 是否启用 PWA
VITE_ENABLE_PWA=true

# 是否启用国际化
VITE_ENABLE_I18N=true

# 默认语言
VITE_DEFAULT_LOCALE=zh-CN

# ===========================================
# 第三方服务配置（可选）
# ===========================================

# Google Analytics ID
VITE_GA_ID=UA-XXXXXXXXX-X

# 百度统计 ID
VITE_BAIDU_ANALYTICS_ID=your_baidu_id

# ===========================================
# 构建配置
# ===========================================

# 构建输出目录
VITE_BUILD_OUTPUT_DIR=dist

# 是否启用 Source Map
VITE_ENABLE_SOURCE_MAP=false

# 是否压缩代码
VITE_MINIFY=true
