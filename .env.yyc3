# ================================================================================
# 三、iMac M4 (yyc3-77) PostgreSQL 15 配置
# ================================================================================

# ----- iMac M4 通用配置 -----
IMAC_PG_VERSION=15.17
IMAC_PG_INSTALL_PATH=/opt/homebrew/opt/postgresql@15
IMAC_PG_DATA_PATH=/opt/homebrew/var/postgresql@15
IMAC_PG_BIN_PATH=/opt/homebrew/opt/postgresql@15/bin
IMAC_PG_PORT=5434
IMAC_PG_USER=postgres
IMAC_PG_PASSWORD=My151001
IMAC_PG_HOST=0.0.0.0
IMAC_PG_SOCKET=/tmp/.s.PGSQL.5434

# ----- iMac M4 认证配置 -----
IMAC_PG_AUTH_METHOD=trust
IMAC_PG_HBA_CONF=/opt/homebrew/var/postgresql@15/pg_hba.conf
IMAC_PG_CONF=/opt/homebrew/var/postgresql@15/postgresql.conf

# ----- iMac M4 网络配置 -----
IMAC_PG_LISTEN_ADDRESSES=*
IMAC_PG_LOCAL_CONNECTION=trust
IMAC_PG_LAN_CONNECTION=trust
IMAC_PG_EXTERNAL_CONNECTION=reject

# ----- iMac M4 服务管理 -----
IMAC_PG_SERVICE_NAME=postgresql@15
IMAC_PG_LAUNCH_AGENT=~/Library/LaunchAgents/homebrew.mxcl.postgresql@15.plist
IMAC_PG_SERVICE_MANAGER=/opt/homebrew/bin/brew services

# ----- iMac M4 备份配置 -----
IMAC_BACKUP_DIR=/Volumes/Development/0379-world/DveOps/yyc3-77_iMac/backup
IMAC_BACKUP_RETENTION_DAYS=30
IMAC_BACKUP_RETENTION_COUNT=10

# ----- iMac M4 日志配置 -----
IMAC_LOG_DIR=/opt/homebrew/var/log/postgresql@15
IMAC_LOG_FILE=postgresql.log
IMAC_LOG_ROTATION=daily
IMAC_LOG_RETENTION_DAYS=7

# ----- iMac M4 性能配置 -----
IMAC_PG_SHARED_BUFFERS=256MB
IMAC_PG_WORK_MEM=64MB
IMAC_PG_MAINTENANCE_WORK_MEM=16MB
IMAC_PG_MAX_CONNECTIONS=100
IMAC_PG_EFFECTIVE_CACHE_SIZE=1GB

# ----- iMac M4 数据库连接字符串 -----
IMAC_PG_SYSTEM_URL=postgresql://postgres:My151001@localhost:5434/postgres
IMAC_PG_DEV_URL=postgresql://postgres:My151001@localhost:5434/yyc3_dev
IMAC_PG_TEST_URL=postgresql://postgres:My151001@localhost:5434/yyc3_test
IMAC_PG_MIRROR_URL=postgresql://postgres:My151001@localhost:5434/yyc3_mirror

# ----- iMac M4 监控配置 -----
IMAC_MONITOR_ENABLED=true
IMAC_MONITOR_INTERVAL=60
IMAC_MONITOR_RETENTION_DAYS=30
IMAC_MONITOR_SLOW_QUERY_THRESHOLD=5000
IMAC_MONITOR_CONNECTION_THRESHOLD=80
IMAC_MONITOR_DISK_USAGE_THRESHOLD=80

# ----- iMac M4 安全配置 -----
IMAC_SECURITY_PASSWORD_MIN_LENGTH=8
IMAC_SECURITY_PASSWORD_MAX_LENGTH=128
IMAC_SECURITY_PASSWORD_REQUIRE_UPPERCASE=true
IMAC_SECURITY_PASSWORD_REQUIRE_LOWERCASE=true
IMAC_SECURITY_PASSWORD_REQUIRE_NUMBER=true
IMAC_SECURITY_PASSWORD_REQUIRE_SPECIAL=true
IMAC_SECURITY_SSL_ENABLED=false
IMAC_SECURITY_SSL_MODE=disable
IMAC_SECURITY_ENCRYPTION=scram-sha-256

# ----- iMac M4 开发工具配置 -----
IMAC_PSQL_CLIENT=/opt/homebrew/opt/postgresql@15/bin/psql
IMAC_PG_DUMP=/opt/homebrew/opt/postgresql@15/bin/pg_dump
IMAC_PG_RESTORE=/opt/homebrew/opt/postgresql@15/bin/pg_restore
IMAC_PG_CTL=/opt/homebrew/opt/postgresql@15/bin/pg_ctl
IMAC_PG_ISREADY=/opt/homebrew/opt/postgresql@15/bin/pg_isready

# ----- iMac M4 服务管理命令 -----
# 启动服务: /opt/homebrew/bin/brew services start postgresql@15
# 停止服务: /opt/homebrew/bin/brew services stop postgresql@15
# 重启服务: /opt/homebrew/bin/brew services restart postgresql@15
# 查看状态: /opt/homebrew/bin/brew services list | grep postgresql

